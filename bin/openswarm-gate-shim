#!/usr/bin/env python3
"""Pre-execution approval gate shim (M38-A slice 1, swrm #288/#292).

Installed by openswarm into `<worktree>/.openswarm-tmp/bin/<verb>` and put
first on the executor child's PATH, so every high-risk shell command the
backend agent runs resolves here *before* the real binary. Classification
mirrors `approval_risk` in bin/openswarm (same four categories, same rule
order); the patterns are copied verbatim from there and kept in agreement
by tests/test_m38a_slice1.py. This file must stay stdlib-only and must NOT
import openswarm: bin/openswarm takes ~0.7s to import, and this shim runs
on every git/cat/... invocation of a gated lane.

Protocol (same record chain as M38 slice 1, #289):
- gate.json missing / gate off / expired -> exec the real binary at once.
- gated invocation -> create a pending approval (run approvals.json +
  global index + ledger + event file), wait for `openswarm approval
  approve|reject`, then exec the real binary (approved) or exit 130
  without executing (rejected / timed out). `decided_ts` is always
  earlier than the real execution: the exec happens only after the
  approval is observed.
- an approval for the same run + command key decided within the last
  120s is reused (covers the loop-first order: a native permission
  request approved in the event loop, then the shell runs it); a
  rejection for the same key within 600s fails fast with 130 and no new
  record (a retrying backend must not hang the lane on fresh pendings).

Exit codes: 130 = gated action not executed (rejected / timed out /
repeat rejection); 127 = real binary not found.
"""

import json
import os
import re
import shlex
import shutil
import sys
import time
import urllib.parse
import uuid

try:
    import fcntl
except ImportError:  # Windows: no flock; writers stay best-effort.
    fcntl = None

EXIT_REJECTED = 130
EXIT_NOT_FOUND = 127

# Verbs this shim is installed as. `echo`/`printf` are shell builtins and
# cannot be intercepted through PATH; absolute-path invocations
# (/usr/bin/git push) bypass PATH shims by construction. Both are
# documented limits, not silent gaps: the event loop still records them.
VERBS = ("git", "npm", "pnpm", "yarn", "twine", "gh", "rm", "sudo",
         "cat", "less", "more", "head", "tail", "bat", "printenv")

# --- classification patterns, verbatim mirrors of bin/openswarm ----------
# enforced_risk() push rule; DEFAULT_RISKS[0] git destructive/push;
# enforced_risk() publish rule; enforced_risk() sudo rule.
_PUSH_RE = re.compile(
    r"\bgit\s+(?:(?:-C|-c|--git-dir|--work-tree)\s+\S+\s+|--[\w-]+= \S+\s+|--[\w-]+\s+)*push\b",
    re.I)
_PUBLISH_RE = re.compile(
    r"\b(npm|pnpm|yarn)\b[^;&|\n]*\bpublish\b|\btwine\s+upload\b|\bgh\s+(release|pr\s+merge)\b",
    re.I)
# enforced_risk() secret rule: DEFAULT_RISKS[3][0] PLUS the .env-file
# alternative appended there (a bare DEFAULT_RISKS[3][0] alone does not
# match `cat .env`); the two parts are one rule, mirrored together.
_SECRET_RE = re.compile(
    r"\b(cat|less|more|head|tail|bat)\s+(?![\s>])[^|;&]*[/\s~.](\.?(auth|credentials?|secrets?)(\.json|\.ya?ml|\.env)?|(?![\w.-]*\.(?:[cm]?[jt]sx?|md|py|go|rs|sh|css|html|swift|kt)(?:\s|$|[|;&]))[\w.-]*(token|secret|password|api[_-]?key)[\w.-]*)(\s|$|[|;&])"
    r"|\b(printenv|echo|printf)\b[^|;&]*\$\{?[A-Z_]*(TOKEN|SECRET|PASSWORD|API_?KEY)[A-Z_]*"
    r"|\bprintenv\b\s*($|[|;&]|[A-Z_]*(TOKEN|SECRET|PASSWORD|API_?KEY))"
    r"|\b(cat|less|more|head|tail|bat)\s+(?:[^|;&]*[/\s])?\.env(?:\.[\w.-]+)?(?:\s|$)",
    re.I)
_SUDO_RE = re.compile(r"\bsudo\b", re.I)
_GIT_DESTRUCTIVE_RE = re.compile(
    r"\bgit\s+(push|reset\s+--hard|checkout\s+-f|clean\s+-[a-z]*f)", re.I)
_SECRET_TOKEN_PREFIXES = ("sk-", "sk-ant-", "ghp_", "gho_", "ghu_", "ghs_",
                          "ghr_", "github_pat_", "AKIA", "xoxb-", "xoxp-",
                          "xoxa-", "xoxr-", "xoxs-", "xoxe-", "glpat-",
                          "npm_", "pypi-", "hf_", "dckr_pat_")
_SAFE_TOKENS = {"git", "push", "npm", "pnpm", "yarn", "publish", "twine",
                "upload", "gh", "release", "pr", "merge", "sudo", "rm", "cd",
                "echo", "printf", "printenv", "cat", "head", "tail", "bash",
                "sh", "&&", "||", ";", "|", "-r", "-rf", "-fr", "-f",
                "--force", "--", "-c", "-lc"}
_TRANSPARENT_WRAPPERS = {"env", "timeout", "nice", "exec", "command",
                         "nohup", "!"}
_SHELLS = {"sh", "bash", "zsh", "dash", "ksh", "fish"}
_SCRATCH_TMP_DIRS = ("/tmp", "/private/tmp", "/var/tmp")

REUSE_APPROVED_SECONDS = 120
REPEAT_REJECTED_SECONDS = 600
POLL_SECONDS = 0.5


def _basename(word):
    return os.path.basename(word)


def command_key(argv):
    """Normalized key of one already-tokenized invocation (token join)."""
    return "\x1f".join(argv) if argv else None


def _rm_target_path_class(target, cwd, root, tmpdir):
    """Mirror rm_target_path_class() in bin/openswarm."""
    for name in ("TMPDIR", "TMP", "TEMP"):
        target = re.sub(rf"\$\{{{name}\}}|\${name}\b", lambda _match: tmpdir, target)
    target = os.path.expanduser(target)
    target = os.path.expandvars(target)
    if "$" in target:
        return "outside"
    path = os.path.realpath(os.path.join(cwd, target))
    try:
        if os.path.commonpath([tmpdir, path]) == tmpdir:
            return "tmp"
        return "inside" if os.path.commonpath([root, path]) == root else "outside"
    except ValueError:
        return "outside"


def _is_scratch_tmp_file(target, cwd):
    """Mirror is_scratch_tmp_file() in bin/openswarm."""
    if any(ch in target for ch in "*?[{~$"):
        return False
    path = os.path.normpath(os.path.join(cwd, target))
    scratch = {os.path.splitdrive(d)[1] for d in
               _SCRATCH_TMP_DIRS + (__import__("tempfile").gettempdir(),)}
    if os.path.splitdrive(os.path.dirname(path))[1] not in scratch:
        return False
    if os.path.basename(path) in ("", ".", ".."):
        return False
    return not os.path.isdir(path)


def _rm_outside_worktree(argv, cwd, worktree):
    """True when a recursive rm reaches outside the worktree.

    Mirrors rm_outside_worktree_class(): only recursive removals of
    outside paths gate; a plain `rm /tmp/file` (single scratch file)
    does not.
    """
    root = os.path.realpath(worktree)
    tmpdir = os.path.join(root, ".openswarm-tmp")
    operands = iter(argv[1:])
    options = True
    recursive = False
    for target in operands:
        if target in (">", ">>", "<", "<<", "2>", "2>>"):
            next(operands, None)
            continue
        if target == "--" and options:
            options = False
            continue
        if options and target.startswith("-"):
            recursive = recursive or target == "--recursive" or (
                not target.startswith("--")
                and any(flag in target for flag in "rR"))
            continue
        path_class = _rm_target_path_class(target, cwd, root, tmpdir)
        if path_class == "outside" and not (
                not recursive and _is_scratch_tmp_file(target, cwd)):
            return True
    return False


def classify(argv, worktree):
    """(category, risk) for one invocation, or None when not gated.

    Rule order mirrors enforced_risk()/approval_risk(): push, publish,
    secret print, sudo, then git destructive / rm outside worktree.
    bypass/force flag, keychain access and computer use are not
    approval categories and stay on the enforcement path.
    """
    if not argv:
        return None
    verb = _basename(argv[0])
    text = shlex.join(argv)
    cwd = os.getcwd()
    if verb == "git":
        if _PUSH_RE.search(text):
            return ("push", "push")
        match = _GIT_DESTRUCTIVE_RE.search(text)
        if match and not str(match.group(1)).lower().startswith("push"):
            return ("destructive", "git destructive")
        return None
    if verb in ("npm", "pnpm", "yarn", "twine", "gh"):
        if _PUBLISH_RE.search(text):
            return ("publish", "publish")
        return None
    if verb in ("cat", "less", "more", "head", "tail", "bat", "printenv"):
        if _SECRET_RE.search(text):
            return ("secret", "secret print")
        return None
    if verb == "sudo":
        if _SUDO_RE.search(text):
            return ("destructive", "sudo")
        return None
    if verb == "rm":
        if _rm_outside_worktree(argv, cwd, worktree):
            return ("destructive", "rm outside worktree")
        return None
    return None


def _scrub_token(token, worktree):
    """Mirror _evidence_scrub_token() in bin/openswarm (D3)."""
    value = token.partition("=")[2] if "=" in token else token
    if any(value.startswith(prefix) for prefix in _SECRET_TOKEN_PREFIXES):
        return "[redacted]"
    if "://" in token:
        try:
            parts = urllib.parse.urlsplit(token)
        except ValueError:
            return "[redacted]"
        if parts.scheme and parts.hostname:
            return f"{parts.scheme}://{parts.hostname}"
        return "[redacted]"
    if worktree and (os.path.isabs(token) or "/" in token
                     or token in ("..", ".")):
        root = os.path.realpath(worktree)
        try:
            if os.path.commonpath(
                    [root, os.path.realpath(os.path.join(root, token))]) != root:
                return "[redacted]"
        except ValueError:
            return "[redacted]"
    elif worktree is None and os.path.isabs(token):
        return "[redacted]"
    return token


def _kept_indices(tokens):
    """Mirror _evidence_kept_indices() in bin/openswarm (D3)."""
    keep = set()
    if not tokens:
        return keep
    verb = _basename(tokens[0])
    rest = [t for t in tokens[1:] if not t.startswith("-")]
    if verb == "git" and rest[:1] == ["push"]:
        start = tokens.index("push", 1) + 1
        kept = 0
        for i in range(start, len(tokens)):
            if tokens[i].startswith("-"):
                continue
            if kept < 2:
                keep.add(i)
                kept += 1
    elif verb in ("npm", "pnpm", "yarn") and rest[:1] == ["publish"]:
        for i, tok in enumerate(tokens):
            if tok == "--tag" and i + 1 < len(tokens):
                keep.update((i, i + 1))
            elif tok.startswith("--tag="):
                keep.add(i)
    elif verb == "gh" and rest[:1] == ["release"]:
        for i in range(2, len(tokens)):
            if not tokens[i].startswith("-"):
                keep.add(i)
                break
        for i in range(3, len(tokens)):
            if not tokens[i].startswith("-"):
                keep.add(i)
                break
    return keep


def evidence_command(argv, worktree):
    """Evidence-redacted command, mirroring redact_command(evidence=True)."""
    keep = _kept_indices(argv)
    return " ".join(_scrub_token(token, worktree) if i in keep else
                    (token if token in _SAFE_TOKENS else "[redacted]")
                    for i, token in enumerate(argv))[:500]


# --- record chain (mirrors request_approval/decide_approval) ------------

def _jload(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return default


def _jsave(path, obj):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(obj, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


class _Lock:
    """Best-effort inter-process lock shared with bin/openswarm."""

    def __init__(self, path):
        self.path = path
        self.fh = None

    def __enter__(self):
        if fcntl is None or not self.path:
            return self
        try:
            parent = os.path.dirname(self.path)
            if parent:
                os.makedirs(parent, exist_ok=True)
            self.fh = open(self.path, "a", encoding="utf-8")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        except OSError:
            self.fh = None
        return self

    def __exit__(self, *exc):
        if self.fh is not None:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_UN)
                self.fh.close()
            except OSError:
                pass
        return False


def _append_line(path, obj):
    """Append one JSON line with a single write (no interleaving)."""
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    line = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


def _ledger_entry(record, kind):
    entry = {"type": kind, "ts": time.time(), "status": f"approval_{record['status']}",
             "run_id": record["run_id"],
             "title": f"approval {record['id']} ({record['category']}/{record['risk']})",
             "approval_id": record["id"], "approval_category": record["category"],
             "approval_risk": record["risk"], "command": record.get("command")}
    if record.get("event_ref"):
        entry["event_ref"] = record["event_ref"]
    return entry


def _event_line_no(event_file):
    try:
        with open(event_file, "rb") as fh:
            return fh.read().count(b"\n") + 1
    except OSError:
        return None


class Gate:
    """A gated invocation: record it, wait, then exec or refuse."""

    def __init__(self, gate, verb, argv):
        self.gate = gate
        self.verb = verb
        self.argv = argv
        self.key = command_key(argv)
        self.category, self.risk = classify(argv, gate.get("worktree") or os.getcwd())
        self.command = evidence_command(argv, gate.get("worktree"))
        self.record = None

    def _fresh_decision(self, status, within_seconds):
        """A same-run, same-key record already decided, or None."""
        index = _jload(self.gate["approvals_index"], {}) or {}
        now = time.time()
        for record in index.values():
            if not isinstance(record, dict):
                continue
            if record.get("run_id") != self.gate["run_id"]:
                continue
            if record.get("status") != status:
                continue
            if record.get("command_key") != self.key:
                continue
            decided = record.get("decided_ts") or 0
            if 0 <= now - decided <= within_seconds:
                return record
        return None

    def create_record(self):
        record = {"id": "appr-" + uuid.uuid4().hex[:12],
                  "run_id": self.gate["run_id"], "status": "pending",
                  "category": self.category, "risk": self.risk,
                  "command": self.command, "command_key": self.key,
                  "pause_point": {"run_id": self.gate["run_id"], "method": "preexec",
                                  "command": self.command, "risk": self.risk,
                                  "category": self.category,
                                  "event_file": self.gate.get("event_file")},
                  "created_ts": time.time(), "decided_ts": None,
                  "decision": None, "decided_by": None, "reason": None}
        event_file = self.gate.get("event_file")
        if event_file:
            line_no = _event_line_no(event_file)
            if line_no is not None:
                record["event_ref"] = {"file": event_file, "line": line_no}
        with _Lock(self.gate.get("lock_file")):
            entries = _jload(self.gate["run_approvals"], []) or []
            entries.append(record)
            _jsave(self.gate["run_approvals"], entries)
            index = _jload(self.gate["approvals_index"], {}) or {}
            index[record["id"]] = record
            _jsave(self.gate["approvals_index"], index)
        _append_line(self.gate["ledger"], _ledger_entry(record, "approval_requested"))
        if event_file:
            _append_line(event_file, {"type": "approval_requested", **record})
        self.record = record
        return record

    def mark_timeout(self):
        """Decide our own record as rejected/timeout (we own the wait)."""
        with _Lock(self.gate.get("lock_file")):
            index = _jload(self.gate["approvals_index"], {}) or {}
            record = dict(index.get(self.record["id"]) or self.record)
            record.update({"status": "rejected", "decision": "rejected",
                           "decided_ts": time.time(), "reason": "timeout"})
            index[record["id"]] = record
            _jsave(self.gate["approvals_index"], index)
            entries = _jload(self.gate["run_approvals"], []) or []
            for i, entry in enumerate(entries):
                if entry.get("id") == record["id"]:
                    entries[i] = record
            _jsave(self.gate["run_approvals"], entries)
        _append_line(self.gate["ledger"], _ledger_entry(record, "approval_rejected"))
        event_file = self.gate.get("event_file")
        if event_file:
            _append_line(event_file, {"type": "approval_rejected",
                                      "approval_id": record["id"],
                                      "category": record["category"],
                                      "reason": "timeout"})
        self.record = record
        return record

    def wait(self):
        """Wait for the CLI decision on our record; None on timeout."""
        deadline = time.time() + max(0, self.gate.get("wait_seconds", 1800))
        gate_deadline = self.gate.get("deadline")
        if gate_deadline:
            deadline = min(deadline, gate_deadline)
        while True:
            entries = _jload(self.gate["run_approvals"], []) or []
            for entry in entries:
                if entry.get("id") == self.record["id"]:
                    if entry.get("status") in ("approved", "rejected"):
                        return entry
                    break
            if time.time() >= deadline:
                return None
            time.sleep(POLL_SECONDS)

    def run(self):
        gate = self.gate
        event_file = gate.get("event_file")
        # Loop-first order: a native permission request for this exact
        # invocation was already approved in the event loop.
        approved = self._fresh_decision("approved", REUSE_APPROVED_SECONDS)
        if approved is not None:
            if event_file:
                _append_line(event_file, {"type": "preexec_resumed",
                                          "approval_id": approved["id"],
                                          "category": self.category,
                                          "command": self.command})
            return 0
        # Retry-after-reject: fail fast, no new record, no fresh wait.
        rejected = self._fresh_decision("rejected", REPEAT_REJECTED_SECONDS)
        if rejected is not None:
            if event_file:
                _append_line(event_file, {"type": "approval_rejected_repeat",
                                          "approval_id": rejected["id"],
                                          "category": self.category,
                                          "command": self.command})
            print(f"openswarm approval gate: {self.category}/{self.risk} "
                  f"{rejected['id']} was already rejected; command not executed",
                  file=sys.stderr)
            return EXIT_REJECTED
        record = self.create_record()
        print(f"openswarm approval gate: {self.category}/{self.risk} "
              f"{record['id']} awaiting decision (command not started)",
              file=sys.stderr)
        decided = self.wait()
        if decided is None:
            self.mark_timeout()
            print(f"openswarm approval gate: {self.category}/{self.risk} "
                  f"{record['id']} timed out; command not executed",
                  file=sys.stderr)
            return EXIT_REJECTED
        if decided["status"] == "approved":
            if event_file:
                _append_line(event_file, {"type": "preexec_approved",
                                          "approval_id": record["id"],
                                          "category": self.category,
                                          "command": self.command,
                                          "decided_ts": decided.get("decided_ts"),
                                          "exec_ts": time.time()})
            return 0
        if event_file:
            _append_line(event_file, {"type": "approval_rejected",
                                      "approval_id": record["id"],
                                      "category": self.category,
                                      "reason": decided.get("reason")})
        print(f"openswarm approval gate: {self.category}/{self.risk} "
              f"{record['id']} rejected"
              f" ({decided.get('reason') or 'no reason'}); command not executed",
              file=sys.stderr)
        return EXIT_REJECTED


def real_binary(verb, shim_bin_dir):
    """The real binary for verb, searching PATH without the shim dir."""
    path = os.environ.get("PATH", "")
    cleaned = os.pathsep.join(
        entry for entry in path.split(os.pathsep)
        if entry and os.path.realpath(entry) != os.path.realpath(shim_bin_dir))
    found = shutil.which(verb, path=cleaned)
    return found


def load_gate(state_dir):
    try:
        with open(os.path.join(state_dir, "gate.json"), encoding="utf-8") as fh:
            gate = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(gate, dict) or not gate.get("enabled"):
        return None
    if gate.get("deadline") and time.time() >= gate["deadline"]:
        return None
    return gate


def main(argv):
    # Invoked as <verb> (installed copy) or `openswarm-gate-shim <verb>`
    # (Windows .cmd wrapper) or with an explicit --state-dir (wrapper only).
    state_dir = None
    args = list(argv[1:])
    if args and args[0] == "--state-dir" and len(args) >= 3:
        state_dir = args[1]
        args = args[2:]
    prog = os.path.basename(argv[0])
    if prog in ("openswarm-gate-shim", "openswarm-gate-shim.py"):
        if not args:
            print("openswarm-gate-shim: missing verb", file=sys.stderr)
            return 2
        verb, rest = args[0], args[1:]
    else:
        verb, rest = prog, args
    if state_dir is None:
        shim_file = os.path.abspath(__file__)
        state_dir = os.path.dirname(os.path.dirname(shim_file))
    shim_bin_dir = os.path.join(state_dir, "bin")
    gate = load_gate(state_dir)
    argv_full = [verb, *rest]
    real = real_binary(verb, shim_bin_dir)
    if gate is None or classify(argv_full, gate.get("worktree") or os.getcwd()) is None:
        # Pass-through: gate off / not armed / not a gated invocation.
        # Behaviour is byte-identical to today (same argv, same stdio).
        if real is None:
            print(f"{verb}: command not found", file=sys.stderr)
            return EXIT_NOT_FOUND
        os.execv(real, argv_full)
        return EXIT_NOT_FOUND
    if real is None:
        print(f"{verb}: command not found", file=sys.stderr)
        return EXIT_NOT_FOUND
    if Gate(gate, verb, argv_full).run() != 0:
        return EXIT_REJECTED
    os.execv(real, argv_full)
    return EXIT_NOT_FOUND


if __name__ == "__main__":
    sys.exit(main(sys.argv))
