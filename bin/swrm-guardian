#!/usr/bin/env python3
"""swrm-guardian — observe-only fleet health guardian (public issue #216).

Reads existing machine-readable openswarm outputs (fleet snapshot, fleet
health, quota, probe cache, resource metrics), normalises them into one
versioned health snapshot and persists that snapshot atomically so a
restarted controller can read it back.

Observe-only: it never dispatches, admits, recovers, restarts a service or
calls a language model, and it never clears a manual drain by observing a
healthy fleet.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from guardian.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
